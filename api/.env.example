# ===== Banco de Dados =====
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=rota471_db

# ===== Servidor =====
PORT=3000
NODE_ENV=development

# ===== Autenticação =====
# OBRIGATÓRIO. Gere um segredo forte com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# ===== CORS =====
# Origens autorizadas (separadas por vírgula). Em produção, use o domínio real do front.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ===== Seed do admin principal (usado por setup_usuarios.js) =====
ADMIN_NOME=Administrador Principal
ADMIN_EMAIL=admin@gmail.com
ADMIN_SENHA=troque-esta-senha
