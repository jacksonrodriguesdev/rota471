# ===== Banco de Dados (MySQL/MariaDB no VPS) =====
DB_HOST=127.0.0.1
DB_USER=mundocar
DB_PASSWORD=TROQUE_por_uma_senha_forte
DB_NAME=mundocar_db

# ===== Servidor =====
PORT=3000
NODE_ENV=production

# ===== Autenticação =====
# OBRIGATÓRIO em produção (mínimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# ===== CORS =====
# O front é servido pelo mesmo domínio, mas liste-o aqui por segurança.
CORS_ORIGINS=https://SEU_DOMINIO.com.br,https://www.SEU_DOMINIO.com.br

# ===== Seed do admin principal (usado uma vez por `npm run setup`) =====
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@SEU_DOMINIO.com.br
ADMIN_SENHA=TROQUE_esta_senha_no_primeiro_deploy
